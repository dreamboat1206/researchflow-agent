APP_ENV=development
LOG_LEVEL=INFO

DATABASE_PATH=data/researchflow.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=papers_text
QDRANT_FIGURES_COLLECTION=paper_figures_text

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=true
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=mock
OPENAI_BASE_URL=
OPENAI_API_KEY=

API_HOST=127.0.0.1
API_PORT=8000
